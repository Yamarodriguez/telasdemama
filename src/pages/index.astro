---
/**
 * Raíz del dominio. En la tienda vieja, / redirige (302) a /es/. En Netlify lo hace _redirects;
 * esta página es el respaldo para cualquier otro servidor.
 */
import { idiomas } from '../lib/catalogo';
const destino = `/${idiomas()[0]}/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <meta name="robots" content="noindex" />
    <title>Telas de Mamá</title>
    <link rel="canonical" href={`https://telasdemama.com${destino}`} />
  </head>
  <body>
    <p><a href={destino}>Telas de Mamá</a></p>
  </body>
</html>
