---
/** Portada de cada idioma: /es/ */
import Base from '../../layouts/Base.astro';
import Portada from '../../components/plantillas/Portada.astro';
import { idiomas, catalogo } from '../../lib/catalogo';
import Rediseno from '../../layouts/Rediseno.astro';
import Portada1 from '../../components/rediseno/Portada1.astro';
import Portada2 from '../../components/rediseno/Portada2.astro';
import { REDISENO, redisenoActivo } from '../../lib/sitio';
import { tituloPortada, h1Portada } from '../../lib/reglas-titulos.mjs';

export function getStaticPaths() {
  return idiomas().map((idioma) => ({ params: { idioma } }));
}
const { idioma } = Astro.params;
const o = catalogo(idioma).otras[`/${idioma}`];
// Fase 3: con el interruptor encendido (src/data/rediseno.json) la portada se monta con las plantillas del rediseño.
const rd = redisenoActivo(`/${idioma}/`);
---
{rd ? (
  <Rediseno idioma={idioma} tipo="index" opcion={REDISENO.opcion} title={tituloPortada(idioma, o.title)} description={o.meta_description} keywords={o.meta_keywords ?? ''} canonical="" hreflang={o.hreflang} urlActual={`/${idioma}/`}>
    {REDISENO.opcion === '2' ? <Portada2 idioma={idioma} h1={h1Portada(idioma)} /> : <Portada1 idioma={idioma} h1={h1Portada(idioma)} />}
  </Rediseno>
) : (
  <Base idioma={idioma} tipo="index" layout="layout-full-width" title={tituloPortada(idioma, o.title)} description={o.meta_description} keywords={o.meta_keywords ?? ''} canonical="" hreflang={o.hreflang} urlActual={`/${idioma}/`} migas={o.breadcrumb} portada>
    <Portada idioma={idioma} />
  </Base>
)}
