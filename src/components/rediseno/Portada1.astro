---
/**
 * Portada de la OPCIÓN 1 (informe §5): hero con foto de tela y dos botones, franja de ventajas, tres accesos con
 * foto, Novedades, «Cómo se pide», bloque de Natalia, opiniones de Revi y preguntas frecuentes.
 * Los productos de Novedades son los «Productos destacados» de la portada actual.
 */
import { bloques, catalogo } from '../../lib/catalogo';
import { textosRediseno, whatsappGenerico, webpDe, srcsetWebp, sobreMi } from '../../lib/rediseno';
import Tarjeta from './Tarjeta.astro';
import Ventajas from './Ventajas.astro';
import Opiniones from './Opiniones.astro';
import Faq from './Faq.astro';
interface Props { idioma: string; h1: string }
const { idioma, h1 } = Astro.props;
const t = textosRediseno(idioma);
const c = catalogo(idioma);
const po = bloques(idioma).portada;
const destacados = c.productosDe(po.destacados.productos);
const titulo = t.hero.titulo || h1;
const heroImg = c.productos.flatMap((p) => p.imagenes).find((i) => i.id === t.hero.imagen_id);
const heroWebp = webpDe(heroImg?.id);
const natalia = sobreMi(idioma);
---
<section class="rd-hero">
  <div class="rd-contenedor rd-hero__cuerpo">
    <div class="rd-hero__texto">
      <h1 class="rd-hero__titulo">{titulo}</h1>
      <p class="rd-hero__linea">{t.hero.texto}</p>
      <div class="rd-botones">
        <a class="rd-btn rd-btn--primario" href={t.hero.boton_telas_href}>{t.hero.boton_telas}</a>
        <a class="rd-btn rd-btn--wa" href={whatsappGenerico(idioma)} target="_blank" rel="noreferrer noopener"><span class="rd-ico-wa" aria-hidden="true"></span>{t.hero.boton_whatsapp}</a>
      </div>
    </div>
    {heroImg && (
      <picture class="rd-hero__foto">
        {heroWebp && <source type="image/webp" srcset={srcsetWebp(heroWebp)} sizes="(min-width: 900px) 50vw, 100vw" />}
        <img src={heroImg.por_tamano.large_default} alt="" width={heroWebp?.ancho ?? 1000} height={heroWebp?.alto ?? 750} fetchpriority="high" />
      </picture>
    )}
  </div>
</section>

<Ventajas idioma={idioma} />

<section class="rd-seccion rd-accesos" aria-label="Secciones de la tienda">
  <div class="rd-contenedor rd-accesos__lista">
    {t.accesos.map((a: any) => (
      <a class="rd-acceso" href={a.href}>
        <img src={a.imagen} alt="" width={a.ancho} height={a.alto} loading="lazy" />
        <span class="rd-acceso__texto"><strong>{a.titulo}</strong><small>{a.subtitulo}</small></span>
      </a>
    ))}
  </div>
</section>

<section class="rd-seccion rd-novedades">
  <div class="rd-contenedor">
    <div class="rd-seccion__cabecera">
      <h2 class="rd-seccion__titulo">{t.novedades.titulo}</h2>
      <a class="rd-enlace" href={t.novedades.href}>{t.novedades.ver_todas}</a>
    </div>
    <ul class="rd-carrusel">
      {destacados.map((p, i) => <li><Tarjeta producto={p} idioma={idioma} opcion="1" prioridad={i < 4} /></li>)}
    </ul>
  </div>
</section>

<section class="rd-seccion rd-pasos">
  <div class="rd-contenedor">
    <h2 class="rd-seccion__titulo">{t.como_se_pide.titulo}</h2>
    <ol class="rd-pasos__lista">
      {t.como_se_pide.pasos.map((p: any, i: number) => (
        <li class="rd-paso">
          <span class="rd-paso__numero" aria-hidden="true">{i + 1}</span>
          <strong>{p.titulo}</strong>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="rd-seccion rd-natalia">
  <div class="rd-contenedor rd-natalia__cuerpo">
    <img class="rd-natalia__foto" src={t.natalia.imagen} alt="" width={t.natalia.ancho} height={t.natalia.alto} loading="lazy" />
    <div class="rd-natalia__texto">
      <h2 class="rd-seccion__titulo">{t.natalia.titulo}</h2>
      {natalia.subtitulo && <p class="rd-natalia__sub">{natalia.subtitulo}</p>}
      {natalia.parrafos.map((p) => <p>{p}</p>)}
      <a class="rd-enlace" href={natalia.href || t.natalia.href}>{t.natalia.enlace}</a>
    </div>
  </div>
</section>

<Opiniones idioma={idioma} />
<Faq idioma={idioma} />
