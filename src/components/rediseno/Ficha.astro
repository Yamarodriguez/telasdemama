---
/**
 * Ficha del rediseño. Galería a la izquierda; a la derecha nombre, referencia, precio (y precio por unidad si la
 * ficha lo tiene), disponibilidad, cantidad, botón grande «Pedir por WhatsApp» con el mensaje precargado y la línea
 * de envío; debajo la descripción tal cual, las opiniones de Revi, los accesorios y otras telas de la categoría.
 * El texto de la tela no se toca (regla A3). Las fichas sin precio (COMBINACIÓN) salen sin precio ni botón.
 */
import type { Producto } from '../../lib/catalogo';
import { bloques, catalogo, textos, nuevo, textoPlano, numeroPlano } from '../../lib/catalogo';
import { absoluta, enlaceWhatsApp, plantilla, REVI } from '../../lib/sitio';
import { textosRediseno, pedible, disponibilidad, precioPorUnidad } from '../../lib/rediseno';
import Galeria from './Galeria.astro';
import Tarjeta from './Tarjeta.astro';
import Migas from './Migas.astro';
interface Props { idioma: string; producto: Producto }
const { idioma, producto: p } = Astro.props;
const t = textos(idioma);
const r = textosRediseno(idioma);
const n = nuevo(idioma);
const c = catalogo(idioma);
const extra = bloques(idioma).fichasExtra[String(p.id)] ?? {};
const dispo = disponibilidad(p);
const unidad = precioPorUnidad(p);
const puede = pedible(p);
const urlAbs = absoluta(p.url);
// Venta por centímetros (Yama, 24-10-2026): el precio de la ficha corresponde a «precio_base_cm» (100 = por metro);
// se enseña el precio por centímetro y el total se calcula en vivo según los centímetros pedidos.
const BASE_CM = Number(n.precio_base_cm) || 100;
const cmPorDefecto = Math.max(Number(n.cantidad_por_defecto_cm) || BASE_CM, p.cantidad_minima || 1);
const euros = (x: number) => x.toFixed(2).replace('.', ',') + ' €';
const precioCm = p.precio_con_iva / BASE_CM;
const totalInicial = euros(Math.round(p.precio_con_iva * cmPorDefecto / BASE_CM * 100) / 100);
const mensaje = plantilla(n.mensaje_ficha_cm || n.mensaje_ficha, { nombre: p.nombre, referencia: p.referencia ?? '', cantidad: '{cantidad}', total: '{total}', url: urlAbs });
const whatsapp = enlaceWhatsApp(n.whatsapp_numero, mensaje.replace('{cantidad}', String(cmPorDefecto)).replace('{total}', totalInicial));
const accesorios = c.productosDe(p.accesorios.map((a) => a.id));
const otros = c.productosDe(extra.otros ?? []).slice(0, 8);
// En muchas fichas la descripción corta y la larga son el mismo texto: la larga solo se repite abajo si es distinta.
const largaDistinta = Boolean(p.descripcion) && textoPlano(p.descripcion).trim() !== textoPlano(p.descripcion_corta || '').trim();
---
<Migas migas={p.breadcrumb} />
<article class="rd-contenedor rd-ficha" data-id={p.id}>
  <div class="rd-ficha__galeria"><Galeria producto={p} idioma={idioma} /></div>
  <div class="rd-ficha__datos">
    <h1 class="rd-ficha__titulo">{p.nombre}</h1>
    <dl class="rd-ficha__ref">
      {p.referencia && <Fragment><dt>{t.referencia}</dt><dd>{p.referencia}</dd></Fragment>}
      {dispo.texto && <Fragment><dt class="rd-oculto">Disponibilidad</dt><dd class:list={['rd-dispo', `rd-dispo--${dispo.estado}`]}>{dispo.texto}</dd></Fragment>}
    </dl>
    {p.muestra_precio && (
      <p class="rd-precio rd-precio--grande">
        <strong class="rd-precio__importe">{p.precio_visible}</strong>
        {p.tiene_descuento && p.precio_tachado != null && <s class="rd-precio__antes">{p.precio_tachado.toFixed(2).replace('.', ',')} €</s>}
        <small class="rd-precio__iva">{t.impuestos_incluidos}</small>
        {unidad && <span class="rd-precio__unidad">{unidad}</span>}
        <span class="rd-precio__cm">{precioCm.toFixed(4).replace('.', ',').replace(/0+$/, '').replace(/,$/, '')} € {r.ficha.por_cm}</span>
      </p>
    )}
    {puede ? (
      <form class="rd-pedido" action="#" method="post" data-mensaje={mensaje} data-numero={n.whatsapp_numero} data-precio={numeroPlano(p.precio_con_iva)} data-base={BASE_CM}>
        <label class="rd-pedido__cantidad" for="rd-cantidad">
          <span>{r.ficha.cantidad_etiqueta || t.cantidad}</span>
          <input type="number" id="rd-cantidad" name="qty" value={cmPorDefecto} min={p.cantidad_minima || 1} step="1" inputmode="numeric" />
        </label>
        <p class="rd-pedido__total"><span>{r.ficha.total}</span> <strong id="rd-total">{totalInicial}</strong></p>
        <a class="rd-btn rd-btn--wa rd-btn--grande rd-pedido__boton" href={whatsapp} target="_blank" rel="noreferrer noopener"><span class="rd-ico-wa" aria-hidden="true"></span>{r.ficha.pedir}</a>
        <button type="button" class="rd-btn rd-btn--primario rd-btn--grande rd-pedido__tarjeta" data-id={p.id} data-cargando={r.ficha.pagar_cargando} data-error={r.ficha.pagar_error}>{r.ficha.pagar_tarjeta}</button>
        <p class="rd-pedido__error" role="alert" hidden></p>
        {r.ficha.cantidad_nota && <p class="rd-pedido__nota">{r.ficha.cantidad_nota}</p>}
      </form>
    ) : (
      p.muestra_precio && <p class="rd-pedido__agotado">{dispo.texto}</p>
    )}
    <p class="rd-ficha__envio">{r.ficha.envio_linea}</p>
    {p.descripcion_corta && <div class="rd-ficha__corta rd-texto" set:html={p.descripcion_corta} />}
  </div>
</article>

<div class="rd-contenedor rd-ficha__mas">
  {largaDistinta && (
    <section class="rd-ficha__bloque">
      <h2 class="rd-seccion__titulo">{t.descripcion}</h2>
      <div class="rd-texto" set:html={p.descripcion} />
    </section>
  )}
  <section class="rd-ficha__bloque rd-ficha__revi">
    <h2 class="rd-seccion__titulo">{t.opiniones}</h2>
    <div id="revi_prod"></div>
    <div class={`revi_widget_product_${REVI.tienda}`}></div>
  </section>
</div>
<script is:inline type="text/javascript" set:html={`var s = document.createElement("script");s.type = "text/javascript";s.setAttribute("async", "");s.setAttribute("defer", "");s.src = "https://revi.io/widgets/product/${REVI.cuenta}/${p.id}/0/${REVI.tienda}/${idioma}";document.getElementsByTagName('body')[0].appendChild(s);`} />

{accesorios.length > 0 && (
  <section class="rd-seccion rd-contenedor">
    <h2 class="rd-seccion__titulo">{t.accesorios}</h2>
    <ul class="rd-carrusel">{accesorios.map((a) => <li><Tarjeta producto={a} idioma={idioma} /></li>)}</ul>
  </section>
)}
{otros.length > 0 && (
  <section class="rd-seccion rd-contenedor">
    <h2 class="rd-seccion__titulo">{r.ficha.otros_titulo}</h2>
    <ul class="rd-carrusel">{otros.map((o) => <li><Tarjeta producto={o} idioma={idioma} /></li>)}</ul>
  </section>
)}

<script is:inline>
  // El enlace de WhatsApp lleva la cantidad que escribe el cliente.
  (function () {
    var form = document.querySelector('.rd-pedido');
    if (!form) return;
    var enlace = form.querySelector('.rd-pedido__boton'), cantidad = form.querySelector('#rd-cantidad'), total = document.getElementById('rd-total');
    var precio = parseFloat(form.getAttribute('data-precio')), base = parseFloat(form.getAttribute('data-base')) || 100;
    var euros = function (x) { return x.toFixed(2).replace('.', ',') + ' €'; };
    var actualizar = function () {
      var n = parseInt(cantidad.value, 10); if (!(n > 0)) n = 1;
      var importe = euros(Math.round(precio * n / base * 100) / 100);
      if (total) total.textContent = importe;
      enlace.setAttribute('href', 'https://wa.me/' + form.getAttribute('data-numero') + '?text=' + encodeURIComponent(form.getAttribute('data-mensaje').replace('{cantidad}', n).replace('{total}', importe)));
    };
    cantidad.addEventListener('input', actualizar); cantidad.addEventListener('change', actualizar);
    // Pago con tarjeta: la función de Netlify recalcula el importe en el servidor y devuelve la dirección de pago de Stripe.
    var tarjeta = form.querySelector('.rd-pedido__tarjeta'), aviso = form.querySelector('.rd-pedido__error');
    if (tarjeta) tarjeta.addEventListener('click', function () {
      var n = parseInt(cantidad.value, 10); if (!(n > 0)) n = 1;
      var texto = tarjeta.textContent;
      tarjeta.disabled = true; tarjeta.textContent = tarjeta.getAttribute('data-cargando'); aviso.hidden = true;
      var fallo = function () { tarjeta.disabled = false; tarjeta.textContent = texto; aviso.textContent = tarjeta.getAttribute('data-error'); aviso.hidden = false; };
      fetch('/.netlify/functions/pago', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(tarjeta.getAttribute('data-id'), 10), cm: n }) })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d && d.url) window.location.href = d.url; else fallo(); })
        .catch(fallo);
    });
    form.addEventListener('submit', function (e) { e.preventDefault(); actualizar(); window.open(enlace.getAttribute('href'), '_blank', 'noopener'); });
    actualizar();
  })();
</script>
