{
  "name": "telasdemama",
  "version": "0.1.0",
  "private": true,
  "description": "telasdemama.com — migración de PrestaShop a Astro (catálogo estático, pedido por WhatsApp)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "referencia": "node herramientas/servir-referencia.mjs",
    "extraer": "python -I herramientas/extraer-ps.py --idioma es",
    "estructura": "python -I herramientas/estructura-viva.py --idioma es",
    "barrido": "node herramientas/barrido-404.mjs --idioma es",
    "todo": "node herramientas/todo.mjs",
    "todo:visual": "node herramientas/todo.mjs --visual",
    "prebuild": "node herramientas/redirecciones.mjs",
    "plantillas": "node herramientas/comparar-plantillas.mjs",
    "bloques": "python -I herramientas/extraer-bloques.py --idioma es"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "node-html-parser": "9.0.4"
  }
}
